{
  "manifest_version": 3,
  "name": "Veridex AI - Scam & Phishing Detector",
  "version": "1.0.0",
  "description": "On-device AI and heuristic browser defense that detects fake websites, typosquatting, phishing pages, and fraudulent links in real time.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Veridex AI"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "engine/brand-database.js",
        "engine/tld-risk.js",
        "engine/ip-intelligence.js",
        "engine/cookie-analyzer.js",
        "engine/veridex-ml-model.js",
        "engine/ai-explanation.js",
        "engine/veridex-engine.js",
        "content/warning-modal.js",
        "content/content.js"
      ],
      "css": [
        "content/warning-modal.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "tabs",
    "webNavigation",
    "storage",
    "notifications",
    "webRequest",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "test-lab/*",
        "website/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
